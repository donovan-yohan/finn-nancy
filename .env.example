# finn-nancy configuration — copy to .env (which is gitignored) and edit.

# Optional OpenAI-compatible LLM endpoint. It may be self-hosted or remote.
LOCAL_LLM_BASE=http://llm.example.invalid/v1
LOCAL_LLM_KEY=change-me
CHAT_MODEL=qwen3.8-27b-unleashed
EMBED_MODEL=qwen3-embedding
# Disabled by default so page renders, ingest, and tests never depend on the embedding endpoint.
EMBEDDINGS_ENABLED=false

# Storage (kept out of git; see .gitignore)
DB_PATH=data/local.sqlite
DATA_DIR=data

# Locale hints for extraction (default currency + generic locale for guesses)
HOME_CURRENCY=CAD
HOME_LOCALE=Exampleville, Example Region

# The unauthenticated UI must stay on loopback. Use an authenticated private
# overlay for remote access; do not bind a LAN or public address.
ADDR=127.0.0.1:8080

# Programmatic API (M8). Unset => /api returns 503 (disabled). Set a long random secret to enable
# Bearer-token access for MCP/automation clients beyond the Tailscale boundary.
# API_TOKEN=change-me-to-a-long-random-secret
# Max /api request body size in bytes before parsing/upload buffering.
# API_MAX_BODY_BYTES=26214400

# Optional capture channels. Strict-local is the default egress kill switch.
# Telegram also remains blocked until its current disclosure is consented to in
# Manage. Set STRICT_LOCAL_MODE=false only after that explicit operator choice.
STRICT_LOCAL_MODE=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
INBOX_DIR=

# Merchant research is inactive until a provider is configured. STRICT_LOCAL_MODE
# overrides provider configuration. Queries are sanitized, but that is not a
# guarantee that a query is non-sensitive; review the provider before opting in.
MERCHANT_SEARCH_PROVIDER=none
MERCHANT_SEARCH_ENDPOINT=
# Brave Web Search is the fallback used only when the self-hosted provider is
# unavailable; its free tier allows one query per second.
BRAVE_API_KEY=
MERCHANT_SEARCH_MIN_INTERVAL_S=1.2
