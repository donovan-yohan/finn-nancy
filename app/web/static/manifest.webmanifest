{
  "name": "finn-nancy",
  "short_name": "finn-nancy",
  "description": "Local-first personal finance for bookkeeping, planning, and reconciliation.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#1f2933",
  "theme_color": "#1f2933",
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "application/pdf"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Take receipt photo",
      "short_name": "Receipt",
      "description": "Capture a receipt with the camera.",
      "url": "/upload?mode=camera&intent=receipt",
      "icons": [
        {
          "src": "/static/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Capture an expense",
      "short_name": "Expense",
      "description": "Add an expense document to the durable outbox.",
      "url": "/upload?mode=shortcut&intent=expense",
      "icons": [
        {
          "src": "/static/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Capture income",
      "short_name": "Income",
      "description": "Add an income document to the durable outbox.",
      "url": "/upload?mode=shortcut&intent=income",
      "icons": [
        {
          "src": "/static/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "icons": [
    {
      "src": "/static/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
