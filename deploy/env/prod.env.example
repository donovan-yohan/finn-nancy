# Example persistent instance configuration.
# Keep real finance data outside the Git checkout and bind only to loopback.

DB_PATH=__DATA_DIR__/finn-nancy.sqlite
DATA_DIR=__DATA_DIR__
ADDR=127.0.0.1:8080
READ_ONLY=false

# Optional OpenAI-compatible LLM endpoint. It may be self-hosted or remote.
LOCAL_LLM_BASE=http://llm.example.invalid/v1
LOCAL_LLM_KEY=change-me
CHAT_MODEL=qwen3.8-27b-unleashed
EMBED_MODEL=qwen3-embedding
LLM_TIMEOUT_S=180
LLM_MAX_RETRIES=3
LLM_CONCURRENCY=1
STRUCTURED_METHOD=json_schema

HOME_CURRENCY=CAD
HOME_LOCALE=Exampleville, Example Region
BIG_TICKET_THRESHOLD_CENTS=30000
CLASSIFY_MIN_CONFIDENCE=0.6

# Merchant research and Telegram are opt-in egress paths. Keep strict-local
# mode enabled unless the operator has reviewed and accepted the disclosure.
STRICT_LOCAL_MODE=true
MERCHANT_SEARCH_PROVIDER=none
MERCHANT_SEARCH_ENDPOINT=
BRAVE_API_KEY=
MERCHANT_SEARCH_MIN_INTERVAL_S=1.2
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
