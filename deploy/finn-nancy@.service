[Unit]
Description=finn-nancy (%i) - local AI finance app
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__REPO__
EnvironmentFile=/etc/finn-nancy/%i.env
Environment=PYTHONUNBUFFERED=1
ExecStartPre=__REPO__/.venv/bin/fn init-db --db ${DB_PATH}
ExecStart=__REPO__/.venv/bin/fn serve --db ${DB_PATH} --addr ${ADDR}
Restart=always
RestartSec=3
TimeoutStopSec=15
UMask=0077

[Install]
WantedBy=multi-user.target
