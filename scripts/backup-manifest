#!/usr/bin/env python3
"""Create or verify WAL-safe release backup manifests."""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPO))

from scripts.backup_manifest_lib import (  # noqa: E402
    ManifestError,
    create_manifest,
    verify_manifest,
)


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Create or verify a WAL-safe finn-nancy release backup manifest."
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    create = subparsers.add_parser(
        "create", help="create a new online SQLite backup and proof manifest"
    )
    create.add_argument("--source-db", required=True, type=Path)
    create.add_argument("--backup", required=True, type=Path)
    create.add_argument("--manifest", required=True, type=Path)

    verify = subparsers.add_parser(
        "verify", help="verify the snapshot, manifest, and migrated proof copy"
    )
    verify.add_argument("--manifest", required=True, type=Path)
    return parser


def main() -> int:
    args = _parser().parse_args()
    try:
        if args.command == "create":
            payload = create_manifest(args.source_db, args.backup, args.manifest)
            print(
                "backup manifest created: "
                f"manifest={args.manifest.resolve()} "
                f"sha256={payload['backup']['sha256']}"
            )
        else:
            payload, backup = verify_manifest(args.manifest)
            print(
                "backup manifest verified: "
                f"backup={backup} sha256={payload['backup']['sha256']}"
            )
    except (ManifestError, OSError) as exc:
        print(f"backup manifest error: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
