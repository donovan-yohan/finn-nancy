#!/usr/bin/env python3
"""Build only an allowlisted archive of a clean, exact local Git commit."""
from __future__ import annotations

import argparse
import hashlib
import io
import json
import re
import subprocess
import tarfile
import tempfile
from pathlib import Path, PurePosixPath

INPUTS = (
    "Dockerfile", ".dockerignore", "pyproject.toml", "uv.lock", "LICENSE", "NOTICE",
    "THIRD_PARTY_NOTICES.md", "app", "migrations", "deploy/container_entrypoint.py",
)
FOUNDATION_INPUTS = {
    "app/web/static/foundation/SOURCE.json",
    "app/web/static/foundation/tokens.json",
    "app/web/static/foundation/vendor/LICENSE.bootstrap",
}


def git(repo: Path, *args: str) -> bytes:
    return subprocess.check_output(["git", "-C", str(repo), *args], stderr=subprocess.PIPE)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repository", type=Path, default=Path(__file__).resolve().parents[1])
    parser.add_argument("--revision", required=True, help="full 40-character commit SHA")
    parser.add_argument("--platform", choices=("linux/arm64", "linux/amd64"), default="linux/arm64")
    parser.add_argument("--tag", help="local image tag; never pushed")
    parser.add_argument("--export-context", type=Path, help="only export the validated tar, do not build")
    args = parser.parse_args()
    if not re.fullmatch(r"[0-9a-f]{40}", args.revision):
        parser.error("revision must be a full lowercase commit SHA")
    repo = args.repository.resolve()
    try:
        if git(repo, "status", "--porcelain", "--untracked-files=all").strip():
            raise ValueError("uncommitted files: commit or remove them before building")
        revision = git(repo, "rev-parse", args.revision + "^{commit}").decode().strip()
        if revision != args.revision:
            raise ValueError("revision is not an exact commit")
        tree = git(repo, "rev-parse", revision + "^{tree}").decode().strip()
        # Read the full selected inventory and raw blob objects, never git archive:
        # export-ignore/export-subst can come from mutable metadata outside the tree.
        entries = {}
        directories = set()
        for entry in git(repo, "ls-tree", "-rz", revision, "--", *INPUTS).split(b"\0"):
            if not entry:
                continue
            metadata, name = entry.split(b"\t", 1)
            mode, kind, oid = metadata.split()
            name = name.decode("utf-8")
            path = PurePosixPath(name)
            if kind != b"blob" or mode not in {b"100644", b"100755"} or path.is_absolute() or ".." in path.parts:
                raise ValueError("unsupported archive member")
            allowed = name in INPUTS
            if path.parts[0] == "app":
                allowed = name in FOUNDATION_INPUTS or path.suffix in {".py", ".html", ".css", ".js", ".png", ".webmanifest"}
            elif path.parts[0] == "migrations":
                allowed = len(path.parts) == 2 and bool(re.fullmatch(r"[0-9]{3}_[a-z0-9_]+\.sql", path.name))
            forbidden = {"data", "private", "credentials", "secrets", "__pycache__", ".venv", ".git"}
            if not allowed or any(part in forbidden or (part.startswith(".") and part != ".dockerignore") for part in path.parts):
                raise ValueError("disallowed build input")
            if name in entries:
                raise ValueError("duplicate build input")
            entries[name] = (int(mode, 8) & 0o777, oid.decode("ascii"))
            directories.update(str(parent) for parent in path.parents if str(parent) != ".")
        inventory = sorted(entries)
        required = set(INPUTS) - {"app", "migrations"}
        required |= {"app/config.py", "migrations/001_tables.sql", "migrations/002_views.sql"}
        if not required.issubset(inventory):
            raise ValueError("required build inputs missing from selected commit")
        buffer = io.BytesIO()
        with tarfile.open(fileobj=buffer, mode="w", format=tarfile.PAX_FORMAT) as archive:
            for name in sorted(directories | set(entries)):
                member = tarfile.TarInfo(name)
                # Fixed ownership/time headers; file modes and bytes are Git's.
                if name in directories:
                    member.type = tarfile.DIRTYPE
                    member.mode = 0o755
                    archive.addfile(member)
                else:
                    member.mode, oid = entries[name]
                    content = git(repo, "cat-file", "blob", oid)
                    member.size = len(content)
                    archive.addfile(member, io.BytesIO(content))
        raw = buffer.getvalue()
        receipt = {"revision": revision, "tree": tree, "platform": args.platform,
                   "context_sha256": hashlib.sha256(raw).hexdigest(), "files": sorted(inventory)}
        if args.export_context:
            with args.export_context.open("xb") as handle:
                handle.write(raw)
        else:
            tag = args.tag or f"finn-nancy:{revision}"
            with tempfile.TemporaryDirectory(prefix="finn-nancy-image-") as directory:
                iid = Path(directory) / "image-id"
                command = ["docker", "buildx", "build", "--load", "--platform", args.platform,
                           "--tag", tag, "--iidfile", str(iid),
                           "--build-arg", f"FINN_NANCY_BUILD_SHA={revision}",
                           "--build-arg", f"FINN_NANCY_BUILD_TREE_SHA={tree}", "-"]
                subprocess.run(command, input=raw, check=True)
                receipt.update(image_id=iid.read_text().strip(), tag=tag)
        print(json.dumps(receipt, sort_keys=True))
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        # No stdout/stderr from Git/Docker or environment contents in this diagnostic.
        message = str(exc) if isinstance(exc, ValueError) else "build/export failed; inspect command output"
        parser.exit(1, message + "\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
