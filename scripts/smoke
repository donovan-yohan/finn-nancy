#!/usr/bin/env bash
set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
SMOKE_DIR="$(mktemp -d "${TMPDIR:-/tmp}/finn-nancy-smoke.XXXXXX")"
DB_PATH="$SMOKE_DIR/smoke.sqlite"
DATA_DIR="$SMOKE_DIR/data"
SERVER_LOG="$SMOKE_DIR/server.log"
API_TOKEN="synthetic-smoke-token"
SERVER_PID=""
KEEP_ARTIFACTS=1

cleanup() {
  if [[ -n "$SERVER_PID" ]] && kill -0 "$SERVER_PID" >/dev/null 2>&1; then
    kill "$SERVER_PID" >/dev/null 2>&1 || true
    wait "$SERVER_PID" >/dev/null 2>&1 || true
  fi
  if [[ "$KEEP_ARTIFACTS" -eq 0 ]]; then
    rm -rf "$SMOKE_DIR"
  else
    echo "smoke artifacts retained at $SMOKE_DIR" >&2
  fi
}
trap cleanup EXIT

port="$(
  uv run --project "$REPO" --frozen python -c \
    'import socket; s=socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1]); s.close()'
)"
BASE_URL="http://127.0.0.1:$port"
EXPECTED_BUILD_SHA="$(git -C "$REPO" rev-parse HEAD)"
EXPECTED_BUILD_TREE_SHA="$(git -C "$REPO" rev-parse 'HEAD^{tree}')"

uv run --project "$REPO" --frozen fn seed-sample --db "$DB_PATH" >/dev/null
mkdir -p "$DATA_DIR"

(
  cd "$SMOKE_DIR"
  export DB_PATH DATA_DIR API_TOKEN
  export ADDR="127.0.0.1:$port"
  export READ_ONLY=false
  export LOCAL_LLM_BASE="http://127.0.0.1:1/v1"
  export LLM_TIMEOUT_S=1
  export TRIAGE_ENABLED=false
  export VERIFIER_LLM_JUDGE=false
  export EMBEDDINGS_ENABLED=false
  export TELEGRAM_BOT_TOKEN=""
  export TELEGRAM_CHAT_ID=""
  export INBOX_DIR=""
  exec uv run --project "$REPO" --frozen fn serve --db "$DB_PATH" --addr "$ADDR"
) >"$SERVER_LOG" 2>&1 &
SERVER_PID="$!"

ready=0
for _ in $(seq 1 60); do
  if curl -fsS "$BASE_URL/healthz" >/dev/null 2>&1; then
    ready=1
    break
  fi
  if ! kill -0 "$SERVER_PID" >/dev/null 2>&1; then
    echo "smoke server exited before readiness" >&2
    tail -n 80 "$SERVER_LOG" >&2 || true
    exit 1
  fi
  sleep 0.25
done
if [[ "$ready" -ne 1 ]]; then
  echo "smoke server did not become ready" >&2
  tail -n 80 "$SERVER_LOG" >&2 || true
  exit 1
fi

for path in / /upload /review /recon /close; do
  curl -fsS -o /dev/null "$BASE_URL$path"
done

version_json="$(curl -fsS "$BASE_URL/version")"
printf '%s' "$version_json" | EXPECTED_BUILD_SHA="$EXPECTED_BUILD_SHA" \
  EXPECTED_BUILD_TREE_SHA="$EXPECTED_BUILD_TREE_SHA" \
  uv run --project "$REPO" --frozen python -c '
import json, re, sys, uuid
import os
payload = json.load(sys.stdin)
required = {
    "version",
    "build_sha",
    "build_tree_sha",
    "database_identity",
    "schema_digest",
    "expected_migration_head",
    "applied_migration_head",
    "expected_migration_digest",
    "applied_migration_digest",
    "migration_status",
    "migration_sequence_matches",
}
missing = required - payload.keys()
if missing:
    raise SystemExit(f"version response missing: {sorted(missing)}")
if not re.fullmatch(r"[0-9a-f]{40}", payload["build_sha"]):
    raise SystemExit("version build_sha is not a full git SHA")
if payload["build_sha"] != os.environ["EXPECTED_BUILD_SHA"]:
    raise SystemExit("version endpoint does not report the exact smoke head")
if not re.fullmatch(r"[0-9a-f]{40}", payload["build_tree_sha"]):
    raise SystemExit("version build_tree_sha is not a full git tree SHA")
if payload["build_tree_sha"] != os.environ["EXPECTED_BUILD_TREE_SHA"]:
    raise SystemExit("version endpoint does not report the exact smoke tree")
identity = payload["database_identity"]
try:
    canonical_identity = str(uuid.UUID(identity))
except (TypeError, ValueError):
    canonical_identity = ""
if canonical_identity != identity:
    raise SystemExit("version database_identity is not a canonical UUID")
for key in ("schema_digest", "expected_migration_digest", "applied_migration_digest"):
    if not re.fullmatch(r"[0-9a-f]{64}", payload[key]):
        raise SystemExit(f"version {key} is not a SHA-256 digest")
if (
    payload["expected_migration_head"] != payload["applied_migration_head"]
    or payload["expected_migration_digest"] != payload["applied_migration_digest"]
    or payload["migration_status"] != "ok"
    or payload["migration_sequence_matches"] is not True
):
    raise SystemExit("smoke database migration sequence does not match code")
'

auth=(-H "Authorization: Bearer $API_TOKEN")
code="$(curl -sS -o /dev/null -w '%{http_code}' "$BASE_URL/api/reconcile")"
if [[ "$code" != "401" ]]; then
  echo "expected unauthenticated API request to return 401, got $code" >&2
  exit 1
fi

sample_body='{"amount_cents":-1234,"posted_on":"2026-07-09","description":"Synthetic API smoke","counterparty":"Synthetic","category":"Restaurants","source":"api_smoke","external_id":"api-smoke-1"}'
first="$(
  curl -fsS "${auth[@]}" -H "Content-Type: application/json" \
    -d "$sample_body" "$BASE_URL/api/transactions"
)"
second="$(
  curl -fsS "${auth[@]}" -H "Content-Type: application/json" \
    -d "$sample_body" "$BASE_URL/api/transactions"
)"
FIRST="$first" SECOND="$second" uv run --project "$REPO" --frozen python -c '
import json, os
first = json.loads(os.environ["FIRST"])
second = json.loads(os.environ["SECOND"])
if first.get("created") is not True or second.get("created") is not False:
    raise SystemExit("API idempotency smoke failed")
if first.get("transaction_id") != second.get("transaction_id"):
    raise SystemExit("API retry created a second transaction")
'

curl -fsS "${auth[@]}" -o /dev/null "$BASE_URL/api/reconcile"

KEEP_ARTIFACTS=0
echo "smoke ok: isolated temporary database, UI routes, version, auth, API idempotency"
