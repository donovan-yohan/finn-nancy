{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "A compact financial workspace. Blue records facts; orange marks interpretation.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.322,
          0.659,
          1
        ],
        "hex": "#52a8ff"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.541,
          0.239
        ],
        "hex": "#ff8a3d"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          0,
          0
        ],
        "hex": "#000000"
      }
    },
    "text": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.961,
          0.961,
          0.961
        ],
        "hex": "#f5f5f5"
      }
    },
    "muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.639,
          0.639,
          0.639
        ],
        "hex": "#a3a3a3"
      }
    },
    "panel": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.039,
          0.039,
          0.039
        ],
        "hex": "#0a0a0a"
      }
    },
    "inset": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.078,
          0.078,
          0.078
        ],
        "hex": "#141414"
      }
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.2,
          0.2,
          0.2
        ],
        "hex": "#333333"
      }
    },
    "light-canvas": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "light-text": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.09,
          0.09,
          0.09
        ],
        "hex": "#171717"
      }
    },
    "light-muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.349,
          0.349,
          0.349
        ],
        "hex": "#595959"
      }
    },
    "light-panel": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.98,
          0.98,
          0.98
        ],
        "hex": "#fafafa"
      }
    },
    "light-inset": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.961,
          0.961,
          0.961
        ],
        "hex": "#f5f5f5"
      }
    },
    "light-border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.831,
          0.831,
          0.831
        ],
        "hex": "#d4d4d4"
      }
    },
    "light-facts": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          0.392,
          0.851
        ],
        "hex": "#0064d9"
      }
    },
    "light-interpretation": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.737,
          0.278,
          0
        ],
        "hex": "#bc4700"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    }
  },
  "typography": {
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "system-ui",
        "fontSize": {
          "value": 1.5,
          "unit": "rem"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": -0.025,
          "unit": "em"
        }
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "system-ui",
        "fontSize": {
          "value": 0.875,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "system-ui",
        "fontSize": {
          "value": 0.75,
          "unit": "rem"
        },
        "fontWeight": 500
      }
    }
  }
}
